# Public — safe to expose to the browser (Next.js requires the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Private — server-only, used in app/api/** route handlers. NEVER expose this.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional — only needed if you enable real card payments
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
